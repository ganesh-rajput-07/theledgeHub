APP_NAME=KnowledgeHub AI
APP_ENV=development
DEBUG=true
API_PORT=8001

# Postgres + pgvector (started by setup.sh via docker compose)
POSTGRES_USER=knowledgehub
POSTGRES_PASSWORD=knowledgehub
POSTGRES_DB=knowledgehub
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://knowledgehub:knowledgehub@localhost:5433/knowledgehub

# Security - setup.sh generates real values in .env
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=change-me

# Embeddings (local)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=250
CHUNK_OVERLAP=50

# Storage / uploads
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# OCR for scanned PDFs (RapidOCR)
OCR_ENABLED=true
OCR_DPI=200
OCR_MIN_TEXT_CHARS=20
OCR_MAX_SIDE_LEN=1280

# Answer generation (BYOK)
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_BASE_URL=http://localhost:11434
RAG_MIN_SCORE=0.30
CHAT_HISTORY_MESSAGES=6
QUERY_REWRITE=llm
QUERY_REWRITE_MAX_TOKENS=2048

# Brute-force protection
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_ATTEMPTS=30
REGISTER_IP_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=900
TRUSTED_PROXIES=127.0.0.1/32,::1/128
