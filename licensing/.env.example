# Licence server settings. Copy to .env and change the secrets.
DATABASE_URL=postgresql+psycopg://knowledgehub:knowledgehub@localhost:5433/licensing
# true in production (HTTPS only); false for http://localhost
COOKIE_SECURE=false
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PORT=8002

# Ed25519 key that signs licence leases (python -m app.cli generate-keys). Keep it secret and backed up.
LEASE_PRIVATE_KEY_FILE=keys/lease_private.pem
PUBLIC_URL=http://localhost:8002
